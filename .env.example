# Local Postgres (matches docker-compose.yml). Used by Prisma from M1 onward.
DATABASE_URL="postgresql://leerlingenraad:leerlingenraad@localhost:5432/leerlingenraad?schema=public"

# Auth.js. Generate a real value per environment with: npx auth secret
AUTH_SECRET="replace-with-a-random-32-byte-value"

# One-time production bootstrap (POST /api/bootstrap) — see README "Eerste
# admin-account aanmaken". Not needed locally (the seed script already
# creates admins); set only on the real deploy, use once.
BOOTSTRAP_SECRET="replace-with-a-random-value"
